+        val l = FirebaseAuth.AuthStateListener { loggedIn = it.currentUser != null }
+        auth.addAuthStateListener(l)
+        onDispose { auth.removeAuthStateListener(l) }
+    }
+
+    var profile by remember { mutableStateOf<UserProfile?>(null) }
